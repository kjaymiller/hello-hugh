# Server
PORT=3001
SESSION_SECRET=change-me-to-a-random-string

# Hugh's shared secret for the check-in submission endpoint
HUGH_PASSWORD=change-me

# Aiven for PostgreSQL — service URI from the Aiven console/MCP, e.g.
# postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
DATABASE_URL=postgres://user:password@host:port/defaultdb?sslmode=require

# S3-compatible object storage for check-in photos
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=hello-hugh-checkins
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
# Set to "true" if the bucket serves objects with a public-read policy,
# in which case the timeline can link directly instead of presigning GETs.
S3_PUBLIC_READ=false

# Slack Incoming Webhook URL for the target channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave unset/empty in production — same-origin requests (the browser
# loading this server's own served frontend) never need CORS at all.
# Only needed for cross-origin dev, e.g. a separate Vite dev server:
CORS_ORIGIN=http://localhost:5173
